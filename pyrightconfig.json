{
  "venvPath": ".",
  "venv": ".venv",
  "pythonVersion": "3.12",
  "include": ["src", "tests"],
  "exclude": ["**/__pycache__"],
  "typeCheckingMode": "basic",
  "reportMissingImports": "none",
  "reportMissingModuleSource": "none",
  "reportTypedDictNotRequiredAccess": "none",
  "reportUnusedExpression": "none"
}
